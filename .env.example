# .env.example - documents the SHAPE of configuration only. Never put real secrets here.
# Copy to .env and fill in real values locally. .env is gitignored.

# Runtime environment: development | staging | production
# In production, placeholder secrets below are rejected loudly at startup.
CBT_ENVIRONMENT=development

# SQLAlchemy URL for the primary database (psycopg 3 driver).
CBT_DATABASE_URL=postgresql+psycopg://cbt:cbt@localhost:5432/cbt

# Application secret used to sign session cookies and CSRF tokens.
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CBT_SECRET_KEY=dev-only-change-me

# Google Gemini: the only model provider (ADR 0006). Required in production.
CBT_GEMINI_API_KEY=
CBT_GEMINI_MODEL=gemini-2.5-flash
CBT_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
