{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run python scripts/check_imports.py:*)",
      "Bash(uv sync:*)",
      "Bash(.venv/Scripts/pytest.exe:*)",
      "Bash(.venv/Scripts/ruff.exe:*)",
      "Bash(.venv/Scripts/mypy.exe:*)",
      "Bash(.venv/Scripts/python.exe scripts/check_imports.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".venv/Scripts/python.exe .claude/hooks/guard_bash.py" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": ".venv/Scripts/python.exe .claude/hooks/protect_paths.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": ".venv/Scripts/python.exe .claude/hooks/format_python.py", "timeout": 30 }
        ]
      }
    ]
  }
}
